# Supabase: browser-safe URL and anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: never expose this value through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# This is an official-download or API endpoint you choose for the TFDA dataset.
# Do not point production at an unverified third-party mirror.
TFDA_DATASET_URL=
